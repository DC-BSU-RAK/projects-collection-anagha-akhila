<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    app:cardCornerRadius="16dp"
    app:cardBackgroundColor="#120E24"
    app:cardElevation="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvModalTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/modal_title"
            android:textColor="#00FFCC"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1F1A3A"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvModalBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/modal_body"
            android:textColor="#8A84A3"
            android:textSize="13sp"
            android:lineSpacingMultiplier="1.3" />

        <Button
            android:id="@+id/btnDismissModal"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="#FF1A75"
            android:text="@string/modal_dismiss"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            app:cornerRadius="8dp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>